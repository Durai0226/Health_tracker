import 'package:flutter/material.dart';
import 'package:drift/drift.dart';
import '../database/app_database.dart';
import '../../features/reminders/models/reminder_model.dart' as ReminderModel;
import '../../features/reminders/models/reminder_category_model.dart' as ReminderCategoryModel;
import '../models/user_settings.dart';
import '../models/action_log.dart' as ActionLogModel;
import 'package:firebase_auth/firebase_auth.dart' as firebase_auth;
import 'package:cloud_firestore/cloud_firestore.dart';

/// New Drift-based storage service to replace the Hive-based StorageService
class DriftStorageService {
  static bool _isInitialized = false;
  static AppDatabase? _database;
  
  static AppDatabase get database {
    _database ??= AppDatabase.instance;
    return _database!;
  }

  static String? get _currentUserId {
    final user = firebase_auth.FirebaseAuth.instance.currentUser;
    if (user != null && !user.isAnonymous) {
      return user.uid;
    }
    return null;
  }

  static Future<void> _syncToCloud<T>(String collection, String docId, Map<String, dynamic> data) async {
    final userId = _currentUserId;
    if (userId == null) return;
    
    try {
      await FirebaseFirestore.instance
          .collection('users')
          .doc(userId)
          .collection(collection)
          .doc(docId)
          .set(data);
      debugPrint('Synced $collection/$docId to cloud');
    } catch (e) {
      debugPrint('Error syncing to cloud: $e');
    }
  }

  static Future<void> _deleteFromCloud(String collection, String docId) async {
    final userId = _currentUserId;
    if (userId == null) return;
    
    try {
      await FirebaseFirestore.instance
          .collection('users')
          .doc(userId)
          .collection(collection)
          .doc(docId)
          .delete();
      debugPrint('Deleted $collection/$docId from cloud');
    } catch (e) {
      debugPrint('Error deleting from cloud: $e');
    }
  }

  static Future<void> init() async {
    if (_isInitialized) {
      debugPrint('DriftStorageService already initialized');
      return;
    }
    
    try {
      // Initialize Drift database
      _database = AppDatabase.instance;
      debugPrint('✓ Drift database initialized');
      
      // Initialize default reminder categories
      await _initDefaultCategories();
      
      _isInitialized = true;
      debugPrint('✓ DriftStorageService initialized successfully');
    } catch (e) {
      debugPrint('Error initializing DriftStorageService: $e');
      rethrow;
    }
  }

  static Future<void> _initDefaultCategories() async {
    try {
      final db = database;
      final existingCategories = await db.remindersDao.getAllCategories();
      
      if (existingCategories.isEmpty) {
        // Create default categories using Drift
        final defaultCategories = [
          ReminderCategoriesCompanion.insert(
            id: 'personal',
            name: 'Personal',
            colorValue: 0xFF4CAF50,
            iconCodePoint: 0xe7fd,
            isDefault: const Value(true),
          ),
          ReminderCategoriesCompanion.insert(
            id: 'work',
            name: 'Work',
            colorValue: 0xFF2196F3,
            iconCodePoint: 0xe89c,
            isDefault: const Value(true),
          ),
          ReminderCategoriesCompanion.insert(
            id: 'health',
            name: 'Health',
            colorValue: 0xFFFF5722,
            iconCodePoint: 0xe3f4,
            isDefault: const Value(true),
          ),
          ReminderCategoriesCompanion.insert(
            id: 'shopping',
            name: 'Shopping',
            colorValue: 0xFFFF9800,
            iconCodePoint: 0xe89a,
            isDefault: const Value(true),
          ),
          ReminderCategoriesCompanion.insert(
            id: 'social',
            name: 'Social',
            colorValue: 0xFFE91E63,
            iconCodePoint: 0xe7ef,
            isDefault: const Value(true),
          ),
        ];
        
        for (final category in defaultCategories) {
          await db.remindersDao.insertCategory(category);
        }
        
        debugPrint('✓ Default reminder categories created');
      }
    } catch (e) {
      debugPrint('Error initializing default categories: $e');
    }
  }

  /// Get user settings (placeholder implementation)
  static UserSettings getUserSettings() {
    // For now, return default settings
    // TODO: Implement proper Drift-based user settings retrieval
    return UserSettings(
      darkModeEnabled: false,
      notificationsEnabled: true,
      soundEnabled: true,
      vibrationEnabled: true,
      snoozeIntervalMinutes: 5,
      snoozeEnabled: true,
      autoBackupEnabled: true,
      cloudSyncEnabled: true,
      biometricsEnabled: false,
      showMotivationalQuotes: true,
      defaultReminderMinutesBefore: 15,
      weekStartsOnMonday: true,
    );
  }

  /// Check if this is the first launch (placeholder implementation)
  static bool get isFirstLaunch {
    // TODO: Implement proper first launch detection using Drift
    return false;
  }

  /// Save reminder using Drift
  static Future<void> saveReminder(ReminderModel.Reminder reminder) async {
    try {
      final db = database;
      final companion = RemindersCompanion.insert(
        id: reminder.id,
        title: reminder.title,
        description: Value(reminder.description),
        categoryId: reminder.categoryId,
        scheduledTime: reminder.scheduledTime,
        repeatType: reminder.repeatType.index,
        priority: reminder.priority.index,
        isCompleted: reminder.isCompleted,
        completedAt: Value(reminder.completedAt),
        isActive: reminder.isActive,
        soundEnabled: reminder.soundEnabled,
        vibrationEnabled: reminder.vibrationEnabled,
        createdAt: reminder.createdAt,
        updatedAt: reminder.updatedAt,
      );
      
      await db.remindersDao.insertReminder(companion);
      
      // Sync to cloud
      await _syncToCloud('reminders', reminder.id, reminder.toJson());
      
      debugPrint('✓ Reminder saved: ${reminder.title}');
    } catch (e) {
      debugPrint('Error saving reminder: $e');
      rethrow;
    }
  }

  /// Get all active reminders using Drift
  static Future<List<ReminderModel.Reminder>> getAllReminders() async {
    try {
      final db = database;
      final reminderRows = await db.remindersDao.getAllReminders();
      
      // Convert Drift rows to model objects
      return reminderRows.map((row) {
        return ReminderModel.Reminder(
          id: row.id,
          title: row.title,
          description: row.description,
          categoryId: row.categoryId,
          scheduledTime: row.scheduledTime,
          repeatType: ReminderModel.RepeatType.values[row.repeatType],
          priority: ReminderModel.ReminderPriority.values[row.priority],
          isCompleted: row.isCompleted,
          completedAt: row.completedAt,
          isActive: row.isActive,
          soundEnabled: row.soundEnabled,
          vibrationEnabled: row.vibrationEnabled,
          createdAt: row.createdAt,
          updatedAt: row.updatedAt,
        );
      }).toList();
    } catch (e) {
      debugPrint('Error getting reminders: $e');
      return [];
    }
  }

  /// Delete reminder using Drift
  static Future<void> deleteReminder(String reminderId) async {
    try {
      final db = database;
      await db.remindersDao.deleteReminder(reminderId);
      
      // Delete from cloud
      await _deleteFromCloud('reminders', reminderId);
      
      debugPrint('✓ Reminder deleted: $reminderId');
    } catch (e) {
      debugPrint('Error deleting reminder: $e');
      rethrow;
    }
  }

  /// Get all reminder categories using Drift
  static Future<List<ReminderCategoryModel.ReminderCategory>> getAllCategories() async {
    try {
      final db = database;
      final categoryRows = await db.remindersDao.getAllCategories();
      
      // Convert Drift rows to model objects
      return categoryRows.map((row) {
        return ReminderCategoryModel.ReminderCategory(
          id: row.id,
          name: row.name,
          colorHex: row.colorHex,
          iconName: row.iconName,
          isDefault: row.isDefault,
          orderIndex: row.orderIndex,
          createdAt: row.createdAt,
        );
      }).toList();
    } catch (e) {
      debugPrint('Error getting categories: $e');
      return [];
    }
  }

  /// Close the database connection
  static Future<void> close() async {
    if (_database != null) {
      await _database!.close();
      _database = null;
      _isInitialized = false;
      debugPrint('✓ DriftStorageService closed');
    }
  }
}
