    {"id": "ssc_q_001", "question": "If x + y = 12 and xy = 35, find x² + y².", "options": ["74", "84", "94", "104"], "correctIndex": 0, "explanation": "x² + y² = (x+y)² - 2xy = 144 - 70 = 74", "subjectId": "quant", "topicId": "algebra", "difficulty": "medium", "examCategory": "ssc", "year": 2023, "tags": ["ssc_cgl", "algebra"]},
    {"id": "ssc_q_002", "question": "A number when divided by 5 gives remainder 3. What is the remainder when square of number is divided by 5?", "options": ["1", "2", "3", "4"], "correctIndex": 3, "explanation": "N = 5k + 3. N² = 25k² + 30k + 9. Remainder = 4", "subjectId": "quant", "topicId": "number_system", "difficulty": "medium", "examCategory": "ssc", "year": 2023, "tags": ["ssc_cgl", "number_system"]},
    {"id": "ssc_q_003", "question": "The speed of a boat in still water is 15 km/hr. It goes 30 km upstream and returns in 4.5 hrs. Speed of stream?", "options": ["3 km/hr", "4 km/hr", "5 km/hr", "6 km/hr"], "correctIndex": 2, "explanation": "30/(15-x) + 30/(15+x) = 4.5. x = 5 km/hr", "subjectId": "quant", "topicId": "boats_streams", "difficulty": "hard", "examCategory": "ssc", "year": 2023, "tags": ["ssc_cgl", "boats_streams"]},
    {"id": "ssc_q_004", "question": "In a triangle, if two angles are 45° and 75°, the triangle is:", "options": ["Acute", "Right", "Obtuse", "Isosceles"], "correctIndex": 0, "explanation": "Third angle = 60°. All angles < 90°, so acute.", "subjectId": "quant", "topicId": "geometry", "difficulty": "easy", "examCategory": "ssc", "year": 2022, "tags": ["ssc_cgl", "geometry"]},
    {"id": "ssc_q_005", "question": "Find sin²30° + cos²60° + tan²45°.", "options": ["1", "1.5", "2", "2.5"], "correctIndex": 1, "explanation": "(1/2)² + (1/2)² + 1² = 0.25 + 0.25 + 1 = 1.5", "subjectId": "quant", "topicId": "trigonometry", "difficulty": "easy", "examCategory": "ssc", "year": 2023, "tags": ["ssc_cgl", "trigonometry"]},
    {"id": "ssc_q_006", "question": "The curved surface area of cylinder is 264 cm² and volume is 924 cm³. Find radius.", "options": ["5 cm", "6 cm", "7 cm", "8 cm"], "correctIndex": 2, "explanation": "V/CSA = r/2 = 924/264 = 3.5. r = 7 cm", "subjectId": "quant", "topicId": "mensuration", "difficulty": "medium", "examCategory": "ssc", "year": 2023, "tags": ["ssc_cgl", "mensuration"]},
    {"id": "ssc_q_007", "question": "If 3x - 2y = 7 and xy = 4, find 9x² + 4y².", "options": ["73", "75", "77", "79"], "correctIndex": 0, "explanation": "9x² + 4y² = (3x - 2y)² + 12xy = 49 + 24 = 73", "subjectId": "quant", "topicId": "algebra", "difficulty": "medium", "examCategory": "ssc", "year": 2022, "tags": ["ssc_cgl", "algebra"]},
    {"id": "ssc_q_008", "question": "A man buys 12 oranges for Rs. 10 and sells 10 oranges for Rs. 12. His profit% is:", "options": ["40%", "44%", "48%", "52%"], "correctIndex": 1, "explanation": "CP of 1 = 10/12. SP of 1 = 12/10. Profit% = 44%", "subjectId": "quant", "topicId": "profit_loss", "difficulty": "medium", "examCategory": "ssc", "year": 2023, "tags": ["ssc_cgl", "profit_loss"]},
