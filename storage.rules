rules_version = '2';

// ==============================================================================
// DailyMinder — Cloud Storage Security Rules
// ==============================================================================
// Mirrors firestore.rules: a single-user personal tracker where every object
// lives under users/{uid}/ and is private to that user. Default-deny; you may
// only read/write your own objects, only while signed in.
//
// No code path uploads to Storage today (the `firebase_storage` dependency is
// unused) — these rules exist so the bucket is locked down *before* anything
// starts writing to it, and to give that future writer a scoped home.
//
// As in Firestore, rules are default-deny and additive: `allow ... if false`
// grants nothing and can never revoke an `allow` from another matching rule, so
// there is no catch-all deny block here. Any path not matched below is denied.
//
// Deploy with:  firebase deploy --only storage
// ==============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    // A signed-in user may read/write only their own folder. Uploads are capped
    // at 20 MB so a compromised client can't run up storage costs. `delete` is
    // listed apart from `create`/`update` because a delete carries no
    // `request.resource` — folding them together under `write` would make the
    // size check error out and block cleanup.
    match /users/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null
                          && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
