rules_version = '2';

// ==============================================================================
// DailyMinder — Cloud Storage Security Rules
// ==============================================================================
// Mirrors firestore.rules: a single-user personal tracker where every object
// lives under users/{uid}/ and is private to that user. Default-deny; you may
// only read/write your own objects, only while signed in.
//
// Deploy with:  firebase deploy --only storage
// (Add a "storage": { "rules": "storage.rules" } block to firebase.json.)
// ==============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    // A signed-in user may read/write only their own folder.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Everything else is denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
