# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # Static linkage — the supported setup for Firebase/Firestore (gRPC, BoringSSL,
  # leveldb). Dynamic frameworks trigger module-map / header-visibility failures
  # for these C/C++ pods.
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Firestore's native deps (leveldb, gRPC, BoringSSL) expose headers under
  # their own `include`/`src/include` dirs, but with use_frameworks! on recent
  # Xcode those search paths don't always propagate to consumers, causing
  # "'leveldb/iterator.h' file not found" etc. Add them to every target.
  grpc_header_paths = [
    '"${PODS_ROOT}/leveldb-library/include"',
    '"${PODS_ROOT}/BoringSSL-GRPC/src/include"',
    '"${PODS_ROOT}/gRPC-Core/include"',
    '"${PODS_ROOT}/gRPC-Core"',
    '"${PODS_ROOT}/gRPC-C++/include"',
    '"${PODS_ROOT}/gRPC-C++"',
    '"${PODS_ROOT}/abseil"',
  ]

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      existing = config.build_settings['HEADER_SEARCH_PATHS']
      existing = existing.is_a?(Array) ? existing : [existing || '$(inherited)']
      config.build_settings['HEADER_SEARCH_PATHS'] = (existing + grpc_header_paths).uniq
    end
  end

  # BoringSSL-GRPC: its sources #include <openssl_grpc/...> but the pod's
  # prepare step doesn't always create that header dir (it ships headers under
  # `openssl/`). Alias `openssl_grpc` -> `openssl` so the includes resolve.
  boringssl_include = File.join(installer.sandbox.root, 'BoringSSL-GRPC', 'src', 'include')
  openssl_dir = File.join(boringssl_include, 'openssl')
  openssl_grpc_dir = File.join(boringssl_include, 'openssl_grpc')
  if File.directory?(openssl_dir) && !File.exist?(openssl_grpc_dir)
    File.symlink('openssl', openssl_grpc_dir)
    Pod::UI.puts "→ Created BoringSSL-GRPC openssl_grpc header alias"
  end
end
