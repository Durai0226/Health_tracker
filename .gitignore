# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle output. `./gradlew :app:compileDebugKotlin` (the pre-Android-build
# check in docs/release-checklist.md) writes a problems report here, which
# otherwise shows up as an untracked directory after every run.
/android/build/
/android/app/build/
/android/.gradle/

# xcodebuild output. A bare `xcodebuild -target ...` (no -derivedDataPath) drops
# products in ios/build/, which the root /build/ rule does not match.
/ios/build/

# Sensitive Config Files
*.env
key.properties
local.properties
**/*.jks
**/*.keystore


# Added by the security pass: *.env misses .env.local/.env.production,
# and Xcode user state leaks the developer username + local UI state.
.env*
**/xcuserdata/
