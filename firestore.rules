rules_version = '2';

// ==============================================================================
// DailyMinder — Firestore Security Rules
// ==============================================================================
// A single-user personal tracker. Every document lives under `users/{userId}`
// and is private to that user, so the security model is strict and simple:
// you may only read/write your own data, only while signed in.
//
// ## How to read this file
//
// Firestore rules are **default-deny and additive**: a path with no matching
// `allow` is denied, and `allow ... if false` grants nothing — it can never
// *revoke* an `allow` granted by another matching rule. So there are no
// "catch-all deny" blocks here: anything not listed below is already denied, and
// writing `if false` rules only creates the false impression that a later rule
// can subtract from an earlier one.
//
// Consequence for maintainers: to expose a new collection you MUST add a `match`
// for it. Adding a field needs no rule change (the client owns the schema).
//
// ## Least privilege
//
// Only the collections the app actually syncs are listed — verified against
// every Firestore call site in `lib/`:
//
//   users/{uid}                          — CloudSyncService (root doc)
//   users/{uid}/medicines/{id}           — CloudSyncService
//   users/{uid}/water_intake/{dateKey}   — CloudSyncService
//   users/{uid}/focus_sessions/{id}      — CloudSyncService
//   users/{uid}/backups/{isoTimestamp}   — BackupService
//   users/{uid}/step_days/{dateKey}      — HealthCloudSyncService
//   users/{uid}/sleep_sessions/{id}      — HealthCloudSyncService
//   users/{uid}/biometric_days/{dateKey} — HealthCloudSyncService
//   users/{uid}/workouts/{id}            — HealthCloudSyncService
//   users/{uid}/health_profile/{id}      — HealthCloudSyncService
//   users/{uid}/period_days/{dateKey}    — HealthCloudSyncService (opt-in)
//
// `step_entries` and `period_settings` were removed: no code path writes them,
// and an unused-but-writable path is attack surface for nothing.
//
// Three paths stay READABLE AND DELETABLE but are no longer writable:
//
//   users/{uid}/reminders/{id}           — writer deleted in 0dd3c72
//   users/{uid}/reminder_categories/{id} — never had a writer
//   users/{uid}/menstrual_cycles/{id}    — derived locally; sync removed
//
// They are not deleted outright because `AuthService.deleteAccount` iterates
// `kUserSubcollections`, and a `.get()` on a path with no match block throws
// permission-denied — which that loop records as a failure and then refuses to
// delete the Auth user. Removing these blocks would make account deletion
// impossible for everyone, and strand whatever an older build wrote. Dropping
// just `create, update` is the part that actually closes surface.
//
// Deploy with:  firebase deploy --only firestore:rules
// ==============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Documents are keyed by their own record id, so the payload's `id` must
    // agree with the document path. Without this a client could file a record
    // under one key while claiming a different identity inside it, which the
    // last-write-wins merge would then propagate to every other device.
    function idMatchesPath(docId) {
      return request.resource.data.id is string
             && request.resource.data.id == docId;
    }

    // Cheap blast-radius cap on a compromised/buggy client: a synced record is a
    // flat map of a few dozen fields, never hundreds. (Firestore already caps a
    // document at 1 MiB; this bounds field count, which cost is driven by.)
    function isReasonableSize() {
      return request.resource.data.keys().size() <= 100;
    }

    function isValidRecord(docId) {
      return idMatchesPath(docId) && isReasonableSize();
    }

    // The ONE field worth validating server-side.
    //
    // Deliberately not a full schema: `syncLwwCollection` ends in
    // `catch (e) { debugPrint(...) }`, so every rules rejection is SILENT.
    // Per-field rules would turn any schema drift into sync that stops forever
    // with no signal to the user or the developer — worse than the malformed
    // write they prevent — and would force a rules deploy in lockstep with
    // every field addition. `isOwner` already means the only party who can
    // write this data is its owner, so field validation mostly defends the
    // user against themselves.
    //
    // `updatedAtMs` is the exception because it is the only field with
    // CROSS-DEVICE consequences, and its failure mode is nasty:
    // lww_collection_sync.dart reads `(cloud['updatedAtMs'] as int?)`.
    // That is a CAST — a string or a wrongly-typed value throws a TypeError,
    // which the outer catch swallows, silently killing sync for that entire
    // collection on every device. One line stops it ever landing.
    //
    // INVARIANT: every collection routed through `syncLwwCollection` requires
    // it — that helper always writes `data['updatedAtMs'] = lMs`, so no
    // legitimate write can fail the check. The eight are medicines,
    // focus_sessions, step_days, sleep_sessions, biometric_days, workouts,
    // health_profile and period_days; `test/core/firestore_rules_lww_test.dart`
    // derives that list from `lib/` and fails when one is missing a check.
    //
    // `water_intake` is deliberately NOT in it: that document is union-merged
    // by log id rather than compared by timestamp, nothing casts an
    // `updatedAtMs` off it, and `DailyWaterData.toJson` does not emit one — so
    // requiring it here would reject every water upload, silently, inside
    // `_syncWaterIntake`'s catch.
    function hasSyncTimestamp() {
      return request.resource.data.updatedAtMs is int;
    }

    // ---- per-user private data --------------------------------------------

    match /users/{userId} {

      // The user root document (profile / sync metadata). `create`/`update` are
      // listed separately from `delete` on purpose: on a delete there is no
      // `request.resource`, so folding them together under `write` would make the
      // size check error out and silently block account cleanup.
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isReasonableSize();

      // Medicines (synced by CloudSyncService through syncLwwCollection).
      match /medicines/{medicineId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && isValidRecord(medicineId)
                              && hasSyncTimestamp();
      }

      // Daily water intake. Keyed by a date string rather than the record id,
      // so the id/path check doesn't apply here — ownership plus the size cap is
      // the boundary. No `hasSyncTimestamp()`: this is the one collection that
      // is union-merged rather than timestamp-compared — see the helper above.
      match /water_intake/{dateKey} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && request.resource.data.id is string
                              && isReasonableSize();
      }

      // Reminders. NOTHING WRITES THESE TWO: `RemindersCloudService` was
      // deleted in 0dd3c72, and the download-only `SyncService` listener that
      // read `/reminders` was deleted along with these write rules. Read and
      // delete survive so `deleteAccount` can still clear whatever an older
      // build left — see the header for why removing the blocks would break it.
      match /reminders/{reminderId} {
        allow read, delete: if isOwner(userId);
      }

      match /reminder_categories/{categoryId} {
        allow read, delete: if isOwner(userId);
      }

      // Cloud backups: one document per backup (keyed by its ISO-8601 creation
      // instant). `data` is a string either way, which is why the payload is
      // base64'd after gzip rather than sent as a Blob — the `is string` check
      // below is deployed separately from the app, so changing the field's
      // type would have silently rejected every backup until a rules deploy
      // caught up. Deliberately no `update` rule — a backup that can be
      // rewritten in place is not a backup, and BackupService only ever
      // creates a fresh doc or deletes an old one.
      match /backups/{backupId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
                      && idMatchesPath(backupId)
                      && request.resource.data.data is string
                      && request.resource.data.sizeBytes is int
                      && isReasonableSize();
      }

      // Period days. Synced only when the user opts in, and owner-private
      // either way — sensitive data never leaves without consent.
      match /period_days/{dateKey} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && isValidRecord(dateKey)
                              && hasSyncTimestamp();
      }

      // Cycles are DERIVED from those days — `PeriodService` recomputes and
      // replaces the whole local set after every log — so they are no longer
      // uploaded. Read and delete only, for the same cleanup reason as the two
      // reminder paths above.
      match /menstrual_cycles/{cycleId} {
        allow read, delete: if isOwner(userId);
      }

      // Steps.
      match /step_days/{dateKey} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && isValidRecord(dateKey)
                              && hasSyncTimestamp();
      }

      // Sleep.
      match /sleep_sessions/{sessionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && isValidRecord(sessionId)
                              && hasSyncTimestamp();
      }

      // Wearable biometrics — DAILY AGGREGATES ONLY. Raw samples are never
      // uploaded: a watch writes ~1 heart-rate sample a minute, and one doc
      // per sample is both a cost and a privacy blast radius for no benefit.
      match /biometric_days/{dateKey} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && isValidRecord(dateKey)
                              && hasSyncTimestamp();
      }

      // Exercise sessions imported from Health Connect / HealthKit.
      match /workouts/{workoutId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && isValidRecord(workoutId)
                              && hasSyncTimestamp();
      }

      // `health_sources` is intentionally absent: the device registry is
      // device-local, cheap to rebuild, and carries user-supplied device
      // names. Nothing writes it to Firestore, so nothing may.

      // Focus sessions.
      //
      // Deliberately here, beside medicines and water, and NOT inside the health
      // block above. Focus is not Health Connect / HealthKit data: it is not
      // covered by the Play "Health apps" declaration, appears in no
      // per-permission justification, and is read from no health permission. It
      // syncs through `CloudSyncService` for the same reason — putting it on the
      // health syncer would drag a productivity timer into a health-data
      // declaration for no benefit.
      //
      // The note field carries free text the user typed (their stated
      // intention), which is why `isReasonableSize` matters here as much as the
      // id check.
      match /focus_sessions/{sessionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && isValidRecord(sessionId)
                              && hasSyncTimestamp();
      }

      // Shared health profile (height/weight/stride — used by Steps and Sleep).
      match /health_profile/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && isValidRecord(docId)
                              && hasSyncTimestamp();
      }
    }
  }
}
