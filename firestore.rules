rules_version = '2';

// ==============================================================================
// DailyMinder — Firestore Security Rules
// ==============================================================================
// A single-user personal tracker. Every document lives under `users/{userId}`
// and is private to that user, so the security model is strict and simple:
// you may only read/write your own data, only while signed in. Anything not
// explicitly matched is denied by default.
//
// Collections the app actually syncs (verified against the codebase):
//   users/{uid}                              — user root doc
//   users/{uid}/medicines/{id}               — CloudSyncService
//   users/{uid}/water_intake/{dateKey}       — CloudSyncService
//   users/{uid}/reminders/{id}               — RemindersCloudService / SyncService
//   users/{uid}/reminder_categories/{id}     — RemindersCloudService
//   users/{uid}/backups/{id}                 — BackupService
//
// Rules for the removed features (period, finance, fitness, notes, habit, mood,
// js_learning, luna, workouts, nutrition, exam-prep) and their shared/global
// collections were deleted along with those features.
// ==============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Lightweight sanity check for synced records (the client owns the schema;
    // the real security boundary is ownership, not field validation).
    function hasStringId() {
      return request.resource.data.id is string
             && request.resource.data.id.size() > 0;
    }

    // ---- per-user private data --------------------------------------------
    match /users/{userId} {

      // The user root document.
      allow read, write: if isOwner(userId);

      // Medicines (synced by CloudSyncService).
      match /medicines/{medicineId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasStringId();
      }

      // Daily water intake (synced by CloudSyncService).
      match /water_intake/{dateKey} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasStringId();
      }

      // Reminders (synced by RemindersCloudService / SyncService).
      match /reminders/{reminderId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasStringId();
      }

      // Reminder categories (synced by RemindersCloudService).
      match /reminder_categories/{categoryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasStringId();
      }

      // Cloud backups (blobs written by BackupService).
      match /backups/{backupId} {
        allow read, write: if isOwner(userId);
      }

      // Any other subcollection under the user is denied (future-proofing:
      // no accidental writes to a mistyped/legacy path).
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ---- global default deny ----------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
