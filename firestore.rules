        allow update: if false;
      }
      
      // ------------------------------------------
      // CATCH-ALL FOR SUBCOLLECTIONS
      // Allows future expansion while maintaining ownership
      // ------------------------------------------
      
      match /{subcollection}/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }
    
    // ==========================================
    // HABIT CHALLENGES (Shared between users)
    // ==========================================
    
    // Habit challenges - shared collection for social features
    match /habitChallenges/{challengeId} {
      // Anyone can read challenges they're part of
      allow read: if isAuthenticatedUser() && 
                    (resource.data.creatorId == request.auth.uid ||
                     request.auth.uid in resource.data.participantIds);
      // Only authenticated (non-anonymous) users can create
      allow create: if isAuthenticatedUser() && 
                      request.resource.data.creatorId == request.auth.uid;
      // Only creator can update
      allow update: if isAuthenticatedUser() && 
                      resource.data.creatorId == request.auth.uid;
      // Only creator can delete
      allow delete: if isAuthenticatedUser() && 
                      resource.data.creatorId == request.auth.uid;
    }
    
    // Habit profiles - public profiles for social features
    match /habitProfiles/{oderId} {
      // Profiles are readable by authenticated users
      allow read: if isAuthenticatedUser();
      // Only owner can write their profile
      allow write: if isAuthenticatedUser() && request.auth.uid == oderId;
    }
    
    // ==========================================
    // EXAM QUESTIONS COLLECTION
    // ==========================================
    
    // Validation for step-by-step solution structure
    function isValidSolutionSteps(data) {
      return data.solutionSteps == null || (
        data.solutionSteps is map &&
        data.solutionSteps.approach is string &&
        data.solutionSteps.steps is list &&
        data.solutionSteps.steps.size() > 0
      );
    }
    
    // Validation for exam question with step-by-step solutions
    function isValidExamQuestion() {
      let data = request.resource.data;
      return data.id is string &&
             data.question is string &&
             data.question.size() > 0 &&
             data.options is list &&
             data.options.size() >= 2 &&
             data.correctIndex is int &&
             data.correctIndex >= 0 &&
             data.correctIndex < data.options.size() &&
             data.explanation is string &&
             data.subjectId is string &&
             data.topicId is string &&
             data.difficulty in ['easy', 'medium', 'hard'] &&
             isValidSolutionSteps(data);
    }
    
    // Exam questions - cloud-stored questions for exam prep feature
    match /exam_questions/{questionId} {
      // Any authenticated user can read questions
      allow read: if isAuthenticated();
      // Only authenticated (non-anonymous) users can write with validation
      allow create: if isAuthenticatedUser() && isValidExamQuestion();
      allow update: if isAuthenticatedUser() && isValidExamQuestion();
      allow delete: if isAuthenticatedUser();
    }
    
    // Exam question categories metadata
    match /exam_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if false;  // Admin only
    }
    
    // Exam question upload metadata
    match /exam_question_metadata/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticatedUser();
    }
    
    // ==========================================
    // GLOBAL SHARED COLLECTIONS (Read-only)
    // ==========================================
    
    // App configuration (managed by admins)
    match /app_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false;  // Admin only via Firebase Console
    }
    
    // Feature flags
    match /feature_flags/{flagId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // ==========================================
    // DEFAULT DENY RULE
    // ==========================================
    
    // Deny access to all other documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
