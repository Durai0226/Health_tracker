    // ==========================================
    // USERS COLLECTION - MAIN RULES
    // ==========================================
    
    match /users/{userId} {
      // User document access
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      // ------------------------------------------
      // NOTES FEATURE
      // ------------------------------------------
      
      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNote();
        allow update: if isOwner(userId) && isValidNote();
        allow delete: if isOwner(userId);
      }
      
      match /note_folders/{folderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFolder();
        allow update: if isOwner(userId) && isValidFolder();
        allow delete: if isOwner(userId);
      }
      
      match /note_tags/{tagId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTag();
        allow update: if isOwner(userId) && isValidTag();
        allow delete: if isOwner(userId);
      }
      
      // Livescribe Notebooks
      match /notebooks/{notebookId} {
