rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // SCHEMA VERSION & MIGRATION SUPPORT
    // ==========================================
    // Current schema version: 2.1.0
    // Migration-ready structure with version tracking
    // Last updated: 2026-03-24
    // 
    // Finance schema updates:
    // - FinanceCategory: Aligned with finance_category.dart (isIncome, isDefault)
    // - FinanceAccount: Aligned with finance_account.dart (includeInTotal, sortOrder)
    // - FinanceTransaction: Aligned with transaction.dart (recurrence as int, attachmentPath)
    // - Budget: Aligned with budget.dart (limit vs amount, categoryIds list, notifyAtPercent)
    // - Bill: Full model alignment with bill.dart (40+ fields)
    // - Added: BillTemplate, BillActivity, BillSettings, BillCategory validation
    
    // ==========================================
    // HELPER FUNCTIONS - CORE
    // ==========================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is authenticated and not anonymous
    function isAuthenticatedUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    
    // Check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ==========================================
    // HELPER FUNCTIONS - TYPE CHECKING
    // ==========================================
    
    // Check if a field exists in the request data
    function hasField(field) {
      return field in request.resource.data;
    }
    
    // Check if a field is optional (doesn't exist or is null)
    function isOptional(field) {
      return !hasField(field) || request.resource.data[field] == null;
    }
    
    // Check if a field is a string
    function isString(field) {
      return hasField(field) && request.resource.data[field] is string;
    }
    
    // Check if a field is an optional string
    function isOptionalString(field) {
      return isOptional(field) || request.resource.data[field] is string;
    }
    
    // Check if a field is a non-empty string
    function isNonEmptyString(field) {
      return isString(field) && request.resource.data[field].size() > 0;
    }
    
    // Check if a string field has valid length
    function isStringWithLength(field, minLen, maxLen) {
      return isString(field) && 
             request.resource.data[field].size() >= minLen && 
             request.resource.data[field].size() <= maxLen;
    }
    
    // Check if a field is a boolean
    function isBool(field) {
      return hasField(field) && request.resource.data[field] is bool;
    }
    
    // Check if a field is an optional boolean
    function isOptionalBool(field) {
      return isOptional(field) || request.resource.data[field] is bool;
    }
    
    // Check if a field is an integer
    function isInt(field) {
      return hasField(field) && request.resource.data[field] is int;
    }
    
    // Check if a field is an optional integer
    function isOptionalInt(field) {
      return isOptional(field) || request.resource.data[field] is int;
    }
    
    // Check if an integer field is within range
    function isIntInRange(field, minVal, maxVal) {
      return isInt(field) && 
             request.resource.data[field] >= minVal && 
             request.resource.data[field] <= maxVal;
    }
    
    // Check if an optional integer field is within range (if present)
    function isOptionalIntInRange(field, minVal, maxVal) {
      return isOptional(field) || 
             (request.resource.data[field] is int && 
              request.resource.data[field] >= minVal && 
              request.resource.data[field] <= maxVal);
    }
    
    // Check if a field is a number (int or float)
    function isNumber(field) {
      return hasField(field) && (request.resource.data[field] is int || request.resource.data[field] is float);
    }
    
    // Check if a field is an optional number
    function isOptionalNumber(field) {
      return isOptional(field) || request.resource.data[field] is int || request.resource.data[field] is float;
    }
    
    // Check if a number field is within range
    function isNumberInRange(field, minVal, maxVal) {
      return isNumber(field) && 
             request.resource.data[field] >= minVal && 
             request.resource.data[field] <= maxVal;
    }
    
    // Check if a field is a list
    function isList(field) {
      return hasField(field) && request.resource.data[field] is list;
    }
    
    // Check if a field is an optional list
    function isOptionalList(field) {
      return isOptional(field) || request.resource.data[field] is list;
    }
    
    // Check if a field is an optional map
    function isOptionalMap(field) {
      return isOptional(field) || request.resource.data[field] is map;
    }
    
    // Check if a field is a timestamp
    function isTimestamp(field) {
      return hasField(field) && request.resource.data[field] is timestamp;
    }
    
    // Check if a field is an optional timestamp
    function isOptionalTimestamp(field) {
      return isOptional(field) || request.resource.data[field] is timestamp;
    }
    
    // Check if a field is a timestamp string (ISO8601)
    function isTimestampString(field) {
      return isString(field) && request.resource.data[field].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*$');
    }
    
    // Check if a field is an optional timestamp string
    function isOptionalTimestampString(field) {
      return isOptional(field) || 
             (request.resource.data[field] is string && 
              request.resource.data[field].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*$'));
    }
    
    // ==========================================
    // HELPER FUNCTIONS - VERSIONING
    // ==========================================
    
    // Check if schema version is valid
    function hasValidVersion() {
      return isOptionalInt('version') || isOptionalInt('schemaVersion');
    }
    
    // ==========================================
    // NOTES SCHEMA VALIDATION
    // ==========================================
    
    // Validate NoteModel schema v2.0
    // Flexible validation - accepts both old and new field names for migration
    function isValidNote() {
      let data = request.resource.data;
      return isNonEmptyString('id') &&
             isString('title') &&  // Can be empty
             isString('content') &&
             isTimestampString('createdAt') &&
             isTimestampString('updatedAt') &&
             isList('tagIds') &&
             isBool('isPinned') &&
             isBool('isArchived') &&
             isBool('isDeleted') &&
             isBool('isSynced') &&
             isIntInRange('noteType', 0, 4) &&  // text, checklist, voice, image, meeting
             isList('attachments') &&
             isIntInRange('priority', 0, 3) &&  // none, low, medium, high
             isBool('isFavorite') &&
             isInt('wordCount') && data.wordCount >= 0 &&
             isBool('isLocked') &&
             isOptionalString('folderId') &&
             isOptionalString('color') &&  // color as string (hex)
             isOptionalString('reminderId') &&
             isOptionalString('aiSummary') &&
             isOptionalString('voiceRecordingPath') &&
             isOptionalInt('voiceDurationSeconds') &&
             isOptionalString('voiceTranscript') &&
             isOptionalString('coverImagePath') &&
             isOptionalTimestampString('reminderDate') &&
             isOptionalString('password');
    }
    
    // Validate FolderModel schema v2.0
    function isValidFolder() {
      return isNonEmptyString('id') &&
             isStringWithLength('name', 1, 100) &&
             isTimestampString('createdAt') &&
             isBool('isSynced') &&
             isOptionalString('parentId') &&
             isOptionalString('color') &&  // color as string (hex)
             isOptionalString('icon');     // icon as string
    }
    
    // Validate TagModel schema v2.0
    function isValidTag() {
      return isNonEmptyString('id') &&
             isNonEmptyString('name') &&
             isBool('isSynced') &&
             isOptionalString('color');  // color as string (hex)
    }
    
    // ==========================================
    // HABIT TRACKER VALIDATION FUNCTIONS
    // ==========================================
    
    // Validate Habit schema
    function isValidHabit() {
      return isNonEmptyString('id') &&
             isNonEmptyString('name') &&
             isInt('iconCodePoint') &&
             isInt('colorValue') &&
             isIntInRange('habitType', 0, 1) &&  // regular, breakBad
             isIntInRange('repeatType', 0, 3) &&  // daily, weekly, monthly, everyXDays
             isList('repeatDays') &&
             isInt('repeatXDays') &&
             isInt('daysPerWeek') &&
             isIntInRange('timeOfDay', 0, 3) &&  // anytime, morning, afternoon, evening
             isBool('hasTarget') &&
             isOptionalNumber('targetValue') &&
             isOptionalString('targetUnit') &&
             isOptionalString('groupId') &&
             isOptionalString('notes') &&
             isBool('isArchived') &&
             isBool('isPaused') &&
             isTimestampString('createdAt') &&
             isTimestampString('updatedAt') &&
             isInt('sortOrder');
    }
    
    // Validate HabitLog schema
    function isValidHabitLog() {
      return isNonEmptyString('id') &&
             isNonEmptyString('habitId') &&
             isTimestampString('date') &&
             isIntInRange('status', 0, 3) &&  // completed, skipped, missed, partial
             isOptionalNumber('value') &&
             isOptionalNumber('targetValue') &&
             isOptionalInt('mood') &&
             isOptionalString('notes') &&
             isTimestampString('loggedAt');
    }
    
    // Validate NotebookModel schema (Livescribe)
    function isValidNotebook() {
      return isNonEmptyString('id') &&
             isString('title') &&
             isOptionalString('description') &&
             isNonEmptyString('coverColor') &&
             isOptionalString('coverImagePath') &&
             isTimestampString('createdAt') &&
             isTimestampString('updatedAt') &&
             isOptionalString('folderId') &&
             isBool('isPinned') &&
             isBool('isArchived') &&
             isBool('isDeleted') &&
             isBool('isSynced') &&
             isOptionalBool('isLocked') &&
             isOptionalString('password') &&
             isList('tagIds') &&
             isInt('pageCount') &&
             isOptionalString('lastPageThumbnail') &&
             isIntInRange('defaultTemplate', 0, 5) &&
             hasValidVersion();
    }
    
    // Validate PageModel schema (Livescribe)
    function isValidPage() {
      return isNonEmptyString('id') &&
             isNonEmptyString('notebookId') &&
             isInt('pageNumber') &&
             isIntInRange('template', 0, 5) &&
             isOptionalString('backgroundColor') &&
             isOptionalString('strokesJson') &&
             isOptionalString('audioClipsJson') &&
             isOptionalString('textContent') &&
             isTimestampString('createdAt') &&
             isTimestampString('updatedAt') &&
             isBool('isSynced') &&
             isOptionalString('thumbnailPath') &&
             isOptionalNumber('scrollOffsetX') &&
             isOptionalNumber('scrollOffsetY') &&
             isOptionalNumber('zoomLevel') &&
             hasValidVersion();
    }
    
    // Validate StrokeModel schema (Livescribe)
    function isValidStroke() {
      return isNonEmptyString('id') &&
             isNonEmptyString('pageId') &&
             isString('pointsJson') &&
             isNonEmptyString('color') &&
             isNumber('strokeWidth') &&
             isIntInRange('tool', 0, 4) &&
             isTimestampString('createdAt') &&
             isOptionalString('linkedAudioClipId') &&
             hasValidVersion();
    }
    
    // Validate AudioClipModel schema (Livescribe)
    function isValidAudioClip() {
      return isNonEmptyString('id') &&
             isNonEmptyString('pageId') &&
             isNonEmptyString('filePath') &&
             isInt('startTimeMs') &&
             isInt('durationSeconds') &&
             isList('linkedStrokeIds') &&
             isTimestampString('createdAt') &&
             isBool('isSynced') &&
             isOptionalString('transcript') &&
             isOptionalString('title') &&
             hasValidVersion();
    }
    
    // ==========================================
    // MEDICATION SCHEMA VALIDATION
    // ==========================================
    
    // Validate EnhancedMedicine schema
    function isValidMedicine() {
      return isNonEmptyString('id') &&
             isNonEmptyString('name') &&
             isOptionalString('genericName') &&
             isOptionalString('brandName') &&
             isIntInRange('dosageForm', 0, 15) &&  // DosageForm enum
             isNumber('strength') &&
             isOptionalString('strengthUnit') &&
             isOptionalString('instructions') &&
             isOptionalString('purpose') &&
             isOptionalString('scheduleJson') &&
             isOptionalIntInRange('colorIndex', 0, 20) &&
             isOptionalIntInRange('shapeIndex', 0, 10) &&
             isOptionalString('imagePath') &&
             isOptionalString('doctorId') &&
             isOptionalString('pharmacyId') &&
             isOptionalString('dependentId') &&
             isOptionalInt('currentStock') &&
             isOptionalInt('lowStockThreshold') &&
             isOptionalBool('refillReminder') &&
             isOptionalTimestampString('expiryDate') &&
             isOptionalString('prescriptionNumber') &&
             isOptionalString('notes') &&
             isBool('isActive') &&
             isBool('isArchived') &&
             isTimestampString('createdAt') &&
             isTimestampString('updatedAt') &&
             hasValidVersion();
    }
    
    // Validate MedicineLog schema
    function isValidMedicineLog() {
      return isNonEmptyString('id') &&
             isNonEmptyString('medicineId') &&
             isTimestampString('scheduledTime') &&
             isOptionalTimestampString('actualTime') &&
             isBool('isTaken') &&
             isBool('isSkipped') &&
             isBool('isMissed') &&
             isOptionalNumber('dosageTaken') &&
             isOptionalIntInRange('skipReason', 0, 10) &&
             isOptionalString('skipNote') &&
             isOptionalString('notes') &&
             isOptionalString('sideEffects') &&
             isOptionalIntInRange('moodRating', 1, 5) &&
             isOptionalIntInRange('effectivenessRating', 1, 5) &&
             isOptionalString('vitalsJson') &&
             isOptionalString('dependentId') &&
             hasValidVersion();
    }
    
    // Validate Doctor schema
    function isValidDoctor() {
      return isNonEmptyString('id') &&
             isNonEmptyString('name') &&
             isOptionalString('specialty') &&
             isOptionalString('phone') &&
             isOptionalString('email') &&
             isOptionalString('address') &&
             isOptionalString('hospital') &&
             isOptionalString('notes') &&
             isOptionalBool('isPrimary') &&
             isTimestampString('createdAt') &&
             hasValidVersion();
    }
    
    // Validate Pharmacy schema
    function isValidPharmacy() {
      return isNonEmptyString('id') &&
             isNonEmptyString('name') &&
             isOptionalString('phone') &&
             isOptionalString('address') &&
             isOptionalString('hours') &&
             isOptionalBool('hasDelivery') &&
             isOptionalString('notes') &&
             isTimestampString('createdAt') &&
             hasValidVersion();
    }
    
    // Validate Clinic schema
    function isValidClinic() {
      return isNonEmptyString('id') &&
             isNonEmptyString('name') &&
             isOptionalString('type') &&
             isOptionalString('address') &&
             isOptionalString('phone') &&
             isOptionalString('email') &&
             isOptionalString('website') &&
             isOptionalString('notes') &&
             isOptionalNumber('latitude') &&
             isOptionalNumber('longitude') &&
             isOptionalString('operatingHoursJson') &&
             isOptionalString('doctorIdsJson') &&
             isTimestampString('createdAt') &&
             isOptionalTimestampString('updatedAt') &&
             hasValidVersion();
    }
    
    // Validate Appointment schema
    function isValidAppointment() {
      return isNonEmptyString('id') &&
             isNonEmptyString('title') &&
             isTimestampString('appointmentDateTime') &&
             isOptionalString('doctorId') &&
             isOptionalString('location') &&
             isOptionalString('notes') &&
             isOptionalBool('reminderEnabled') &&
             isOptionalInt('reminderMinutesBefore') &&
             isBool('isCompleted') &&
             isOptionalString('dependentId') &&
             isOptionalString('medicineIdsJson') &&
             isTimestampString('createdAt') &&
             hasValidVersion();
    }
    
    // Validate DependentProfile schema
    function isValidDependent() {
      return isNonEmptyString('id') &&
             isNonEmptyString('name') &&
             isIntInRange('relationshipType', 0, 10) &&
             isOptionalTimestampString('dateOfBirth') &&
             isOptionalString('bloodType') &&
             isOptionalString('allergiesJson') &&
             isOptionalString('conditionsJson') &&
             isOptionalString('notes') &&
             isOptionalString('photoPath') &&
             isOptionalString('gender') &&
             isOptionalNumber('weight') &&
             isOptionalNumber('height') &&
             isOptionalString('emergencyContact') &&
             isOptionalString('emergencyPhone') &&
             isOptionalString('primaryDoctorId') &&
             isOptionalString('insuranceInfo') &&
             isBool('isActive') &&
             isTimestampString('createdAt') &&
             hasValidVersion();
    }
    
    // Validate TreatmentCourse schema
    function isValidTreatment() {
      return isNonEmptyString('id') &&
             isNonEmptyString('name') &&
             isOptionalString('condition') &&
             isOptionalString('description') &&
             isOptionalString('doctorId') &&
             isTimestampString('startDate') &&
             isOptionalTimestampString('endDate') &&
             isOptionalString('notes') &&
             isOptionalString('medicineIdsJson') &&
             isOptionalString('dependentId') &&
             isBool('isActive') &&
             isTimestampString('createdAt') &&
             hasValidVersion();
    }
    
    // ==========================================
    // WATER/HYDRATION SCHEMA VALIDATION
    // ==========================================
    
    // Validate DailyWaterData schema
    function isValidDailyWaterData() {
      let data = request.resource.data;
      return isNonEmptyString('id') &&
             isTimestampString('date') &&
             isInt('dailyGoalMl') && data.dailyGoalMl > 0 &&
             isInt('totalIntakeMl') && data.totalIntakeMl >= 0 &&
             isInt('effectiveHydrationMl') && data.effectiveHydrationMl >= 0 &&
             isOptionalInt('totalCaffeineMg') &&
             isOptionalInt('alcoholicDrinksCount') &&
             isBool('goalReached') &&
             isOptionalTimestampString('goalReachedAt') &&
             isOptionalList('logs') &&
             hasValidVersion();
    }
    
    // Validate WaterLog schema
    function isValidWaterLog() {
      let data = request.resource.data;
      return isNonEmptyString('id') &&
             isTimestampString('time') &&
             isInt('amountMl') && data.amountMl > 0 &&
             isInt('effectiveHydrationMl') &&
             isNonEmptyString('beverageId') &&
             isNonEmptyString('beverageName') &&
             isOptionalString('beverageEmoji') &&
             isIntInRange('hydrationPercent', 0, 200) &&
             isOptionalString('containerId') &&
             isOptionalString('containerName') &&
             isOptionalInt('caffeineAmount') &&
             isOptionalBool('isAlcoholic') &&
             isOptionalString('note') &&
             hasValidVersion();
    }
    
    // Validate HydrationProfile schema
    function isValidHydrationProfile() {
      return isNonEmptyString('id') &&
             isOptionalNumber('weightKg') &&
             isOptionalIntInRange('activityLevel', 0, 4) &&
             isOptionalIntInRange('climateType', 0, 3) &&
             isOptionalInt('customGoalMl') &&
             isOptionalBool('useCustomGoal') &&
             isOptionalBool('pregnantOrNursing') &&
             isOptionalString('healthConditionsJson') &&
             isTimestampString('createdAt') &&
             isOptionalTimestampString('updatedAt') &&
             hasValidVersion();
    }
    
    // Validate WaterAchievements schema
    function isValidWaterAchievements() {
      return isNonEmptyString('id') &&
             isOptionalInt('totalDrinks') &&
             isOptionalInt('totalMl') &&
             isOptionalInt('currentStreak') &&
             isOptionalInt('longestStreak') &&
             isOptionalInt('daysGoalMet') &&
             isOptionalTimestampString('lastGoalMetDate') &&
             isOptionalInt('totalPoints') &&
             isOptionalString('achievementsJson') &&
             hasValidVersion();
    }
    
    // ==========================================
    // FINANCE SCHEMA VALIDATION
    // ==========================================
    
    // Validate FinanceCategory schema
    // Matches: lib/features/finance/models/finance_category.dart
    function isValidFinanceCategory() {
      return isNonEmptyString('id') &&
             isNonEmptyString('name') &&
             isInt('iconCodePoint') &&
             isInt('colorValue') &&
             isOptionalBool('isIncome') &&
             isOptionalBool('isDefault') &&
             isOptionalInt('sortOrder') &&
             hasValidVersion();
    }
    
    // Validate FinanceAccount schema
    // Matches: lib/features/finance/models/finance_account.dart
    function isValidFinanceAccount() {
      return isNonEmptyString('id') &&
             isNonEmptyString('name') &&
             isIntInRange('type', 0, 5) &&  // AccountType: cash, bank, creditCard, savings, investment, wallet
             isNumber('balance') &&
             isOptionalInt('colorValue') &&
             isOptionalInt('iconCodePoint') &&
             isOptionalString('currency') &&
             isOptionalBool('includeInTotal') &&
             isOptionalBool('isArchived') &&
             isOptionalInt('sortOrder') &&
             isTimestampString('createdAt') &&
             hasValidVersion();
    }
    
    // Validate FinanceTransaction schema
    // Matches: lib/features/finance/models/transaction.dart
    function isValidFinanceTransaction() {
      return isNonEmptyString('id') &&
             isNumber('amount') &&
             isIntInRange('type', 0, 2) &&  // TransactionType: income, expense, transfer
             isString('categoryId') &&
             isString('accountId') &&
             isOptionalString('toAccountId') &&
             isTimestampString('date') &&
             isOptionalString('note') &&
             isOptionalIntInRange('recurrence', 0, 4) &&  // RecurrenceType: none, daily, weekly, monthly, yearly
             isOptionalList('tags') &&
             isOptionalString('attachmentPath') &&
             isTimestampString('createdAt') &&
             hasValidVersion();
    }
    
    // Validate Budget schema
    // Matches: lib/features/finance/models/budget.dart
    function isValidBudget() {
      let data = request.resource.data;
      return isNonEmptyString('id') &&
             isNonEmptyString('name') &&
             isNumber('limit') && data.limit >= 0 &&
             isOptionalNumber('spent') &&
             isIntInRange('period', 0, 2) &&  // BudgetPeriod: weekly, monthly, yearly
             isList('categoryIds') &&
             isOptionalInt('colorValue') &&
             isTimestampString('startDate') &&
             isOptionalBool('isArchived') &&
             isOptionalBool('notifyAtPercent') &&
             isOptionalIntInRange('notifyPercent', 0, 100) &&
             isTimestampString('createdAt') &&
             hasValidVersion();
    }
    
    // Validate Bill schema
    // Matches: lib/features/finance/models/bill.dart
    function isValidBill() {
      let data = request.resource.data;
      return isNonEmptyString('id') &&
             isNonEmptyString('name') &&
             isNumber('amount') && data.amount >= 0 &&
             isTimestampString('dueDate') &&
             isIntInRange('status', 0, 7) &&  // BillStatus enum values
             isIntInRange('recurrence', 0, 7) &&  // BillRecurrence enum values
             isOptionalInt('customRecurrenceInterval') &&
             isOptionalInt('customRecurrenceUnit') &&
             isOptionalString('categoryId') &&
             isOptionalString('accountId') &&
             isOptionalString('note') &&
             isOptionalString('receiptUrl') &&
             isOptionalList('tags') &&
             isOptionalInt('gracePeriodDays') &&
             isOptionalBool('isDeleted') &&
             isOptionalBool('isArchived') &&
             isOptionalString('templateId') &&
             isOptionalString('parentBillId') &&
             isOptionalNumber('paidAmount') &&
             isOptionalList('reminders') &&
             isOptionalString('currency') &&
             isOptionalNumber('exchangeRate') &&
             isOptionalInt('colorValue') &&
             isOptionalInt('iconCodePoint') &&
             isOptionalString('deviceId') &&
             isOptionalList('notificationIds') &&
             isOptionalBool('remindersEnabled') &&
             isOptionalIntInRange('priority', 0, 3) &&
             isOptionalList('attachmentUrls') &&
             isOptionalInt('escalationRemindersSent') &&
             isOptionalTimestampString('lastReminderSentAt') &&
             isOptionalTimestampString('lastScheduledAt') &&
             isOptionalString('updatedByDeviceId') &&
             isTimestampString('createdAt') &&
             isTimestampString('updatedAt') &&
             hasValidVersion();
    }
    
    // Validate BillCategory schema
    // Matches: lib/features/finance/models/bill.dart (BillCategory class)
    function isValidBillCategory() {
      return isNonEmptyString('id') &&
             isNonEmptyString('name') &&
             isInt('colorValue') &&
             isInt('iconCodePoint') &&
             isOptionalBool('isCustom') &&
             isTimestampString('createdAt') &&
             hasValidVersion();
    }
    
    // Validate BillPayment schema
    // Matches: lib/features/finance/models/bill.dart (BillPayment class)
    function isValidBillPayment() {
      let data = request.resource.data;
      return isNonEmptyString('id') &&
             isNonEmptyString('billId') &&
             isNumber('amount') && data.amount > 0 &&
             isTimestampString('paidAt') &&
             isOptionalString('accountId') &&
             isOptionalString('note') &&
             isOptionalString('transactionId') &&
             isTimestampString('createdAt') &&
             hasValidVersion();
    }
    
    // Validate FinanceSyncStatus schema
    // For tracking sync state across devices
    function isValidFinanceSyncStatus() {
      return isNonEmptyString('id') &&
             isOptionalTimestamp('lastSyncToCloud') &&
             isOptionalTimestamp('lastSyncFromCloud') &&
             isOptionalInt('transactionsCount') &&
             isOptionalInt('accountsCount') &&
             isOptionalInt('budgetsCount') &&
             isOptionalInt('billsCount') &&
             isOptionalString('lastDeviceId') &&
             hasValidVersion();
    }
    
    // Validate BillTemplate schema
    // Matches: lib/features/finance/models/bill_template.dart
    function isValidBillTemplate() {
      let data = request.resource.data;
      return isNonEmptyString('id') &&
             isNonEmptyString('name') &&
             isNumber('amount') && data.amount >= 0 &&
             isIntInRange('recurrence', 0, 7) &&
             isOptionalInt('customRecurrenceInterval') &&
             isOptionalInt('customRecurrenceUnit') &&
             isOptionalIntInRange('advancedRecurrenceType', 0, 4) &&
             isOptionalInt('nthWeekday') &&
             isOptionalInt('weekdayIndex') &&
             isTimestampString('nextDueDate') &&
             isOptionalString('categoryId') &&
             isOptionalString('accountId') &&
             isOptionalString('note') &&
             isOptionalInt('gracePeriodDays') &&
             isOptionalInt('colorValue') &&
             isOptionalInt('iconCodePoint') &&
             isOptionalList('reminders') &&
             isOptionalBool('remindersEnabled') &&
             isOptionalString('currency') &&
             isOptionalList('tags') &&
             isOptionalIntInRange('priority', 0, 2) &&
             isOptionalBool('isActive') &&
             isOptionalTimestampString('lastInstanceGeneratedAt') &&
